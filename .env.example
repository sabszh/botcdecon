# ----------------------------
# App environment
# ----------------------------
ENVIRONMENT=production
DEBUG=false

# Default language shown in the installation
DEFAULT_LANGUAGE=da

# Local corpus file inside the container
DATA_JSON_PATH=data/all.json

# If frontend and backend are served from the same domain through Caddy,
# this can stay as "*". If you want to lock it down, set it to:
# API_ALLOW_ORIGINS=https://example.com
API_ALLOW_ORIGINS=*
API_ALLOW_CREDENTIALS=false

# Bind only on localhost on the server, so Caddy/Nginx is the public entrypoint
APP_PORT_BIND=127.0.0.1:8000


# ----------------------------
# Archive / database
# ----------------------------
# Turn this on if you want sessions stored in Postgres
ARCHIVE_DB_ENABLED=true

# Postgres container/database credentials
POSTGRES_DB=continuonus
POSTGRES_USER=continuonus
POSTGRES_PASSWORD=replace-with-a-strong-db-password

# SQLAlchemy connection string used by the backend.
# Keep host as "db" because that is the Docker Compose service name.
DATABASE_URL=postgresql+psycopg://continuonus:replace-with-a-strong-db-password@db:5432/continuonus

# Optional archive DB tuning
ARCHIVE_DB_CONNECT_TIMEOUT_SEC=2
ARCHIVE_DB_INIT_MAX_ATTEMPTS=5
ARCHIVE_DB_RETRY_DELAY_SEC=1.0


# ----------------------------
# Admin interface
# ----------------------------
# Required if you want to use /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password


# ----------------------------
# LLM provider
# ----------------------------
LLM_PROVIDER=mistral

# Required for production chat responses
MISTRAL_API_KEY=replace-with-your-mistral-api-key
MISTRAL_MODEL=mistral-small-latest

# Optional HuggingFace fallback, usually leave empty
HUGGINGFACE_API_KEY=
LLM_REPO_ID=


# ----------------------------
# TTS / voice
# ----------------------------
# Hosting does not require these to be ready right now if you are handling voice later.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
VOICE_ID=4PzN60Ir6O2U6RzaQ5fm
MODEL_ID=eleven_multilingual_v2


# ----------------------------
# Optional entry sync
# ----------------------------
# If you want startup sync from the remote source, leave this on.
# If you want a fully fixed installation dataset, set it to false.
ENTRIES_SOURCE_URL=https://cc.n-kort.net/entries/all
SYNC_ENTRIES_ON_STARTUP=true
ENTRIES_SYNC_TIMEOUT_SEC=20


# ----------------------------
# Local prompt tracing
# ----------------------------
# Enable this locally if you want each prompt/input/output written as JSON
# files for prompt tuning. Safe to leave off in production.
PROMPT_TRACE_ENABLED=false
PROMPT_TRACE_DIR=output/prompt_traces
